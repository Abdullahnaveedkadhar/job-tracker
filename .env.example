# Copy to .env.local for local development:
#   cp .env.example .env.local

# ─── Supabase (required) ───
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Or newer Supabase UI name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: auto-apply schema (npm run db:apply) — Database → Connection string URI
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# ─── Gemini (required for CV generation) ───
# Server only — set in Vercel Environment Variables for production
GEMINI_API_KEY=
# Optional model override (default in app: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ─── Job discovery (optional but recommended) ───
# Free Adzuna API keys: https://developer.adzuna.com/
# Company Greenhouse/Lever boards work without keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ─── Public site (optional) ───
# Canonical URL, used for Open Graph link previews.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Read-only demo account (optional) ───
# Set both to show an "Explore the demo" button on the landing and login pages.
# These are exposed to the browser by design, so point them at a throwaway
# account that holds only sample data.
# NEXT_PUBLIC_DEMO_EMAIL=demo@example.com
# NEXT_PUBLIC_DEMO_PASSWORD=
