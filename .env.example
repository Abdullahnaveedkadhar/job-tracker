# Copy to .env.local for local development:
#   cp .env.example .env.local

# ─── Supabase (required) ───
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Or newer Supabase UI name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# One-time profile seed (npm run seed:profile) — no Next.js needed; never commit
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
# SUPABASE_SECRET_KEY=sb_secret_...   (new Supabase secret key, same as service role)
# Or sign in as yourself without service role:
# SEED_USER_EMAIL=you@example.com
# SEED_USER_PASSWORD=your-app-login-password

# Optional: auto-apply schema (npm run db:apply) — Database → Connection string URI
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres

# ─── Gemini (required for CV generation) ───
# Server only — set in Vercel Environment Variables for production
GEMINI_API_KEY=
# Optional model override (default in app: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
